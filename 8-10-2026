<!-- Write a simple module - we will create our local module 
simple loggin moudle which logs the information   -->
<!-- log.js -->
var log = {
    info: function(info) {
        console.log('Info: ' + info);
    },
    warning: function (warning) {
        console.log('Warning: '+ warning);
    },
    error: function(error) {
        console.log('Error: '+error);
    }
}; module.exports = log;
<!-- logapp.js -->
var logger = require('./log');
logger.info('Node.js application created');
logger.warning('Warning Message is here');

